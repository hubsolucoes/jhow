# Kit Bling - configuração do cliente Python.
# Copie para ".env" (mesma pasta de cliente.py) e preencha. NUNCA versione o arquivo .env.

# sandbox = conta Bling de TESTE (o Bling não tem sandbox separado; a URL é a mesma)
# producao = conta real da empresa (o cliente avisa antes de gravar dados)
BLING_AMBIENTE=sandbox

# Credenciais do aplicativo: Bling > Central de Extensões > Área do Integrador > seu app > Informações do app
BLING_CLIENT_ID=<<SEU_CLIENT_ID>>
BLING_CLIENT_SECRET=<<SEU_CLIENT_SECRET>>

# Arquivo onde o cliente guarda access_token/refresh_token (criado no comando "autorizar").
# Use um arquivo por ambiente/conta. Em servidor, prefira um cofre de segredos.
BLING_TOKENS_ARQUIVO=bling_tokens_sandbox.json

# Opcional: planilha do kit onde o comando "renovar --excel" grava o AccessToken (tabela tbConfig).
BLING_EXCEL_PLANILHA=

# Opcional: timeout das requisições em segundos
BLING_TIMEOUT=60
