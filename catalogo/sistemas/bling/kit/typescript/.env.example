# Kit Bling - configuração do cliente TypeScript (Node 18+).
# Copie para ".env" (mesma pasta de cliente.ts) e preencha. NUNCA versione o arquivo .env.

# sandbox = conta Bling de TESTE (o Bling não tem sandbox separado; a URL é a mesma)
# producao = conta real da empresa (o cliente pede confirmação antes de gravar dados)
BLING_AMBIENTE=sandbox

# Bling > Central de Extensões > Área do Integrador > seu app > Informações do app
BLING_CLIENT_ID=<<SEU_CLIENT_ID>>
BLING_CLIENT_SECRET=<<SEU_CLIENT_SECRET>>

# Onde o cliente guarda os tokens (um arquivo por conta/ambiente). Em servidor, prefira cofre de segredos.
BLING_TOKENS_ARQUIVO=bling_tokens_sandbox.json

# Timeout das requisições em milissegundos
BLING_TIMEOUT_MS=60000
