# Copie para .env e preencha. Este é o ÚNICO lugar com credenciais.
# sandbox = https://homologacao.focusnfe.com.br (sem validade fiscal) | producao = https://api.focusnfe.com.br
FOCUS_AMBIENTE=sandbox
# Token da empresa no painel Focus NFe, do mesmo ambiente acima (usuário do HTTP Basic; a senha fica vazia)
FOCUS_TOKEN=<<SEU_TOKEN_FOCUS_NFE>>
# CNPJ da empresa, 14 dígitos sem pontuação (usado nas consultas de notas recebidas e nos exemplos)
FOCUS_CNPJ=<<CNPJ_DA_EMPRESA>>
