# Kit Asaas — Python. Copie para ".env" e preencha. Este é o ÚNICO arquivo com credenciais.
# Ambiente: sandbox (padrão, testes) ou producao (dinheiro real).
ASAAS_AMBIENTE=sandbox
# Chave de API do MESMO ambiente (sandbox: $aact_hmlg_... | produção: $aact_prod_...).
# Use aspas simples: a chave começa com "$".
ASAAS_API_KEY='<<SUA_API_KEY>>'
# Nome da sua aplicação (header User-Agent, exigido para contas novas).
ASAAS_USER_AGENT=minha-empresa-integracao/1.0
# Opcional: token (32 a 255 caracteres) que você cadastrou no webhook; usado para validar o header asaas-access-token.
ASAAS_WEBHOOK_TOKEN='<<SEU_TOKEN_DE_WEBHOOK>>'
